# Kalshi demo/paper credentials — NEVER commit real keys.
# Create a demo account at https://demo.kalshi.co/ then
# Account & security → API Keys.
# Public prod REST (events/books) needs no key.

KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=./secrets/kalshi-demo.key
# Alternative to a key file (PEM text). Prefer the path.
# KALSHI_PRIVATE_KEY=

# Environment is demo-only for *orders* unless KALSHI_ALLOW_PRODUCTION=1
KALSHI_ENV=demo

# Public prod data REST is the research default (no key).
# KALSHI_DATA_REST=https://external-api.kalshi.com/trade-api/v2
# Demo order REST is used only with --demo-submit.
# KALSHI_ORDER_REST=https://external-api.demo.kalshi.co/trade-api/v2

# Read-only prod WebSocket (never required for paper-tape).
# KALSHI_WS_ENV=demo
# KALSHI_ALLOW_PROD_WS=0

# Paper bankroll. Risk Desk v1 limits rescale from this.
KALSHI_BANKROLL=1000

# Dry-run + paper-tape is the default. Demo order submit requires --demo-submit.
KALSHI_DRY_RUN=true
KALSHI_PAPER_TAPE=true
KALSHI_LATENCY_MS=150
KALSHI_TOB_HEARTBEAT_MS=100
# KALSHI_CFB_5HZ=false

# Comma-separated 15-minute crypto Up/Down series
# Paper-v2-tight soak: BTC-only.
KALSHI_SERIES=KXBTC15M,KXETH15M
# KALSHI_SERIES=KXBTC15M

# Clip size in dollars (clamped $10–$30). Paper-v2-tight uses $10.
KALSHI_CLIP_DOLLARS=20
# KALSHI_CLIP_DOLLARS=10

# one_sided (default). Do not switch to two_sided unless Risk later OK.
KALSHI_QUOTE_MODE=one_sided
KALSHI_IMPROVE_TICKS=0

# Soft unpaired abort (seconds). Flatten leftover inventory after this age.
# Paper-v2-tight: 45s. 0 disables age abort; $30 onesided kill still applies.
KALSHI_MAX_UNPAIRED_AGE_SECONDS=45

# Soft onesided flatten / no-grow preference (hard kill stays $30 / 3%).
KALSHI_SOFT_ONESIDED=10

# Max concurrent 15m windows (Risk Desk default 2). Use 1 for single-series.
# KALSHI_MAX_WINDOWS=1

# No new risk this many seconds before close (Risk Desk floor 60s).
# Paper-v2-tight attempt uses 120s.
KALSHI_LAST_SECONDS=120

# Only open new quotes when bid_sum ≤ 1 − min_edge (underround / Regime B).
KALSHI_ONLY_QUOTE_UNDERROUND=false

# Minimum locked edge (dollars per contract). Paper-v2-tight: 0.04 (bid_sum ≤ 0.96).
KALSHI_MIN_EDGE=0.04

# Taker–taker pair arb is usually not viable; leave off.
KALSHI_TAKER_PAIR_ARB=false

# Paper recycle after close (seconds). Measured p99≈59s; default 75 sits in
# the 60–90s band. Do NOT use expected_expiration (~+300s) as settle-lock.
KALSHI_SETTLE_RECYCLE_SECONDS=75
# Conservative rare-tail wait (300s). Off by default.
KALSHI_SETTLE_RARE_TAIL=false
# KALSHI_SETTLE_RARE_TAIL_SECONDS=300

KALSHI_WINDOWS_PATH=data/windows.json
KALSHI_TAPE_PATH=data/tape.jsonl

# 15-minute or greater crypto Up/Down only. 5-minute series are refused.
KALSHI_MIN_WINDOW_MINUTES=15

# Bloomberg HUD (kalshi-pbot hud). Off for headless run.
# KALSHI_HUD=false
# KALSHI_HUD_PORT=8080

KALSHI_LOG_LEVEL=INFO
